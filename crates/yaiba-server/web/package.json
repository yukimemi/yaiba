{
  "name": "yaiba-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "_comment": "`bun run vite` on Windows swallows vite's stdout (bun bug). Calling node + vite.js directly bypasses bun's script-shim layer entirely.",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
