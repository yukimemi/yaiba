# kata:gitignore:base:begin
# Editor / OS noise — kata-managed (yukimemi/pj-base).
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# APM dependencies — install output of apm.yml's deps.
# Skill files under .agents/, .claude/, .gemini/ etc. are
# committed (kata seeds them; renri post_create refreshes via
# `apm install --update`); the apm_modules/ source cache is not.
apm_modules/
# kata:gitignore:base:end

# --- yaiba ---------------------------------------------------------
# Rust build output.
/target/

# The SPA's dependencies, and its build output.
#
# `web/dist/` is regenerated by `cargo make build-web` and baked into
# the binary by rust-embed — committing it would put a minified bundle
# in every diff. The directory itself is kept (`.gitkeep`) because
# rust-embed needs the folder to exist for a release build to compile.
crates/yaiba-server/web/node_modules/
crates/yaiba-server/web/dist/*
!crates/yaiba-server/web/dist/.gitkeep

# Scratch databases from `cargo make dev` and manual runs.
*.db
*.db-wal
*.db-shm
